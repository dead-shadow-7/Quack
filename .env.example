# Copy to `.env` (already gitignored) — docker compose reads it automatically.
# Everything here has a working default; override only what you need.

# Host port the UI + API are published on.
API_PORT=3000

# ── Consumed directly by the code, if you run it outside compose ─────────────
# crawler/db.py, indexer/db.py, searchAPI/db.js
# MONGO_URI=mongodb://localhost:27017/
# MONGO_DB=search_engine
#
# indexer/indexer.py
# REDIS_HOST=localhost
# REDIS_PORT=6379
#
# searchAPI/server.js
# PORT=3000
# HOST=0.0.0.0
# FRONTEND_DIR=../frontend
